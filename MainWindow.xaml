<Window x:Class="SSTLogAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:conv="clr-namespace:SSTLogAnalyser.Converters"
        Title="SST Log Analyser" Height="900" Width="1400"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#F5F5F5">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:FailCountToColorConverter x:Key="FailColorConv"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style x:Key="LegendPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LegendThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#9AA1AA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="1,0" Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6F7782"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#4F5863"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LegendScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="{TemplateBinding Background}">
                            <Border Width="4" HorizontalAlignment="Center" Background="#12000000" CornerRadius="2"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource LegendPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LegendThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource LegendPageButtonStyle}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8E8E8" Padding="8,4">
            <DockPanel>
                <Button Content="Load Files" Command="{Binding LoadFilesCommand}" DockPanel.Dock="Left"/>
                <Button Content="Clear All" Command="{Binding ClearAllCommand}" DockPanel.Dock="Left"/>
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                             Height="16" Width="200" DockPanel.Dock="Right"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" FontSize="12" Foreground="#555"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="8,2">
            <ItemsControl ItemsSource="{Binding LoadedFiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#D0E8D0" CornerRadius="3" Padding="6,2" Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text=" (Loops: " FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding LoopCount}" FontSize="11" Foreground="#666"/>
                                <TextBlock Text=")" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <GroupBox Header="Search">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4" FontSize="12"/>
                    </GroupBox>
                    <GroupBox Header="Module Type">
                        <ListBox ItemsSource="{Binding AvailableModules}" SelectedItem="{Binding SelectedModule}" MaxHeight="120"/>
                    </GroupBox>
                    <GroupBox Header="Channels / Pins">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="2,2,2,4">
                                <Button Content="ALL" Width="44" Height="22" Margin="0" Padding="0"
                                        Click="AllChannels_Click" ToolTip="Show all channels"/>
                                <Button Width="24" Height="22" Margin="4,0,0,0" Padding="0"
                                        Click="PreviousChannelPage_Click" ToolTip="Select previous 128 channels">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                                </Button>
                                <Button Width="24" Height="22" Margin="2,0,0,0" Padding="0"
                                        Click="NextChannelPage_Click" ToolTip="Select next 128 channels">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="11"/>
                                </Button>
                                <TextBlock x:Name="ChannelPageText" Text="0 / 0" Margin="6,0,0,0"
                                           VerticalAlignment="Center" FontSize="10" Foreground="#555"/>
                            </StackPanel>
                            <ListBox x:Name="ChannelList" Grid.Row="1"
                                     ItemsSource="{Binding AvailableChannels}"
                                     SelectionMode="Extended" MaxHeight="150"
                                     SelectionChanged="ChannelList_SelectionChanged"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Test Item">
                        <ListBox ItemsSource="{Binding AvailableTestItems}" SelectedItem="{Binding SelectedTestItem}" MaxHeight="180"/>
                    </GroupBox>
                    <GroupBox Header="Loops">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Content="ALL" Width="44" Height="22" Margin="2,2,2,4"
                                    HorizontalAlignment="Left" Padding="0"
                                    Click="AllLoops_Click" ToolTip="Show all loops"/>
                            <ListBox x:Name="LoopList" Grid.Row="1"
                                     ItemsSource="{Binding AvailableLoops}"
                                     SelectionMode="Extended" MaxHeight="120"
                                     SelectionChanged="LoopList_SelectionChanged"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Comparison Mode">
                        <StackPanel>
                            <RadioButton Content="Multi-Channel (same loop)" IsChecked="{Binding CompareMultiChannel}"
                                         Checked="MultiChannel_Checked" Margin="0,2"/>
                            <RadioButton Content="Multi-Loop (same channel)" IsChecked="{Binding CompareMultiLoop}"
                                         Checked="MultiLoop_Checked" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Rendering">
                        <CheckBox Content="Performance Mode (fast, no points)"
                                  IsChecked="{Binding PerformanceMode}" Margin="0,2"
                                  ToolTip="Reduce point markers for large selections"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#CCC"/>

            <TabControl x:Name="MainTabControl" Grid.Column="2" Margin="4"
                        SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chart" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <lvc:CartesianChart x:Name="MainChart"
                            PreviewMouseLeftButtonDown="MainChart_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="MainChart_PreviewMouseLeftButtonUp"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            AnimationsSpeed="{Binding ChartAnimationsSpeed}"
                            ZoomMode="Both"
                            ZoomingSpeed="0.15"
                            Background="White"
                            TooltipPosition="Hidden"
                            LegendPosition="Hidden"
                            MouseMove="MainChart_MouseMove"
                            MouseLeave="MainChart_MouseLeave"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="72,8,0,0"
                                Padding="6,3" MaxWidth="520" Panel.ZIndex="4"
                                Background="#B0FFFFFF" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                                IsHitTestVisible="False"
                                Visibility="{Binding ChartRenderSummary, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="{Binding ChartRenderSummary}" FontSize="10" Foreground="#555"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Panel.ZIndex="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Show all" Width="56" Height="22" FontSize="10" Margin="0,0,4,0"
                                        Background="#B0FFFFFF" BorderBrush="#AAA" Padding="0"
                                        Command="{Binding ShowAllSeriesCommand}"
                                        Visibility="{Binding HasSeriesFocus, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Show all chart series"/>
                                <Button Content="Reset" Width="48" Height="22" FontSize="10" Margin="0,0,4,0"
                                        Background="#B0FFFFFF" BorderBrush="#AAA" Padding="0"
                                        Command="{Binding ResetChartZoomCommand}"
                                        ToolTip="Reset chart zoom; left-drag to pan, right-drag to zoom by section"/>
                                <Button Content="Legend" Width="56" Height="22" FontSize="10"
                                        Background="#B0FFFFFF" BorderBrush="#AAA" Padding="0"
                                        Command="{Binding ToggleLegendCommand}"
                                        ToolTip="Show/Hide Legend"/>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="8,4" Margin="0,2,0,0"
                                    MaxWidth="280"
                                    Background="#B0FFFFFF" BorderBrush="#DDD" BorderThickness="1"
                                    Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                                <ListBox ItemsSource="{Binding LegendItems}" MaxHeight="360"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource LegendScrollBarStyle}"/>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="2,1"
                                                        HorizontalContentAlignment="Left" Cursor="Hand"
                                                        Command="{Binding DataContext.ToggleSeriesFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Toggle series focus">
                                                    <StackPanel Orientation="Horizontal" Opacity="{Binding DisplayOpacity}">
                                                        <Rectangle Width="14" Height="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   Fill="{Binding ColorBrush}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#333"
                                                                   MaxWidth="230" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" FontWeight="{Binding FontWeight}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                        <Border x:Name="TooltipPanel"
                                CornerRadius="4" Padding="8,5"
                                Background="#E0FFFFFF" BorderBrush="#999" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" IsHitTestVisible="False"
                                Panel.ZIndex="10">
                            <StackPanel>
                                <TextBlock Text="{Binding TooltipTitle}" FontWeight="Bold" FontSize="11" Foreground="#333"/>
                                <TextBlock Text="{Binding TooltipExpect}" FontSize="10" Foreground="#555" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding TooltipDiff}" FontSize="10" Foreground="#555"/>
                                <TextBlock Text="{Binding TooltipExtra}" FontSize="10" Foreground="#777" Margin="0,2,0,0"
                                           Visibility="{Binding TooltipExtra, Converter={StaticResource StringToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pass/Fail Matrix" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="1"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding PassFailEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Margin="4" AlternatingRowBackground="#F8F8F8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Channel" Binding="{Binding ChannelId}" Width="80"/>
                            <DataGridTextColumn Header="Test Item" Binding="{Binding TestItemName}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalCount}" Width="60"/>
                            <DataGridTextColumn Header="Failures" Binding="{Binding FailCount}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="{Binding FailCount, Converter={StaticResource FailColorConv}}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Data" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="2"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid x:Name="ChartDataGrid" ItemsSource="{Binding ChartDataRows}" SelectedItem="{Binding SelectedChartRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                              Margin="4" AlternatingRowBackground="#F8F8F8" SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Background" Value="#FFE0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileId}" Width="50"/>
                            <DataGridTextColumn Header="Loop" Binding="{Binding LoopIndex}" Width="50"/>
                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleType}" Width="70"/>
                            <DataGridTextColumn Header="Channel" Binding="{Binding ChannelId}" Width="60"/>
                            <DataGridTextColumn Header="Test Item" Binding="{Binding TestItemName}" Width="150"/>
                            <DataGridTextColumn Header="Expected" Binding="{Binding ExpectValue, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Measured" Binding="{Binding MeasureValue, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Low Limit" Binding="{Binding LowLimit, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="High Limit" Binding="{Binding UpLimit, StringFormat=G6}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Failed" Binding="{Binding IsFailed}" Width="60"/>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Statistics" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="3"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding Statistics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Margin="4" AlternatingRowBackground="#F8F8F8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="100"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Mean" Binding="{Binding Mean, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="StdDev" Binding="{Binding StdDev, StringFormat=G6}" Width="100"/>
                            <DataGridTextColumn Header="Failures" Binding="{Binding FailCount}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="{Binding FailCount, Converter={StaticResource FailColorConv}}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Errors / FATAL" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="4"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding ErrorEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Margin="4" AlternatingRowBackground="#F8F8F8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loop" Binding="{Binding LoopIndex}" Width="50"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="160"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Device Info" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="5"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="System Information" Margin="4">
                            <DataGrid ItemsSource="{Binding SystemInfos}" AutoGenerateColumns="False" IsReadOnly="True" Margin="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="160"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Device Mapping" Margin="4">
                            <DataGrid ItemsSource="{Binding DeviceEntries}" AutoGenerateColumns="False" IsReadOnly="True" Margin="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group" Binding="{Binding GroupNumber}" Width="60"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding LocationId}" Width="80"/>
                                    <DataGridTextColumn Header="Slot" Binding="{Binding SlotInfo}" Width="100"/>
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="DiagnosticsTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                            <Button Content="[+]" FontSize="10" Width="24" Height="18" Padding="0" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Detach to floating window"
                                    Click="DetachTab_Click" Tag="6"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid x:Name="DiagnosticsGrid" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="340"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="260"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*" MinHeight="260"/>
                        </Grid.RowDefinitions>

                        <GroupBox x:Name="ToleranceHeatmapPanel" Grid.Row="0" Grid.Column="0" Margin="2">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tolerance Utilization Heatmap" VerticalAlignment="Center"/>
                                    <Button x:Name="ToleranceHeatmapExpandButton" Width="22" Height="18" Padding="0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Maximize chart" Click="DiagnosticExpand_Click" Tag="Tolerance">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding ToleranceHeatmapSummary}" Margin="6,2" FontSize="11"
                                           Foreground="#555" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ToleranceHeatmapSummary}"/>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding ToleranceHeatmapSeries}"
                                                    XAxes="{Binding ToleranceHeatmapXAxes}"
                                                    YAxes="{Binding ToleranceHeatmapYAxes}"
                                                    ZoomMode="Both" ZoomingSpeed="0.15"
                                                    LegendPosition="Hidden"
                                                    TooltipPosition="Top"
                                                    Background="White"/>
                            </Grid>
                        </GroupBox>

                        <GridSplitter x:Name="DiagnosticsVerticalSplitter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                      Width="4" HorizontalAlignment="Stretch" Background="#D4D7DA"/>

                        <GroupBox x:Name="CoefficientDistributionPanel" Grid.Row="0" Grid.Column="2" Margin="2">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gain / Offset Distribution" VerticalAlignment="Center"/>
                                    <Button x:Name="CoefficientDistributionExpandButton" Width="22" Height="18" Padding="0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Maximize chart" Click="DiagnosticExpand_Click" Tag="Coefficient">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="6,2">
                                    <ComboBox DockPanel.Dock="Right" Width="270" Margin="8,0,0,0"
                                              ItemsSource="{Binding AvailableCoefficientNames}"
                                              SelectedItem="{Binding SelectedCoefficientName}"
                                              ToolTip="Calibration coefficient"/>
                                    <TextBlock Text="{Binding CoefficientSummary}" FontSize="11" Foreground="#555"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CoefficientSummary}"/>
                                </DockPanel>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding GainSeries}"
                                                    XAxes="{Binding GainXAxes}"
                                                    YAxes="{Binding GainYAxes}"
                                                    ZoomMode="Both" ZoomingSpeed="0.15"
                                                    LegendPosition="Hidden" TooltipPosition="Top"
                                                    Background="White"/>
                                <lvc:CartesianChart Grid.Row="2"
                                                    Series="{Binding OffsetSeries}"
                                                    XAxes="{Binding OffsetXAxes}"
                                                    YAxes="{Binding OffsetYAxes}"
                                                    ZoomMode="Both" ZoomingSpeed="0.15"
                                                    LegendPosition="Hidden" TooltipPosition="Top"
                                                    Background="White"/>
                            </Grid>
                        </GroupBox>

                        <GridSplitter x:Name="DiagnosticsHorizontalSplitter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                      Height="4" VerticalAlignment="Stretch" Background="#D4D7DA"/>

                        <GroupBox x:Name="ResidualSignaturePanel" Grid.Row="2" Grid.Column="0" Margin="2">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Residual Signature" VerticalAlignment="Center"/>
                                    <Button x:Name="ResidualSignatureExpandButton" Width="22" Height="18" Padding="0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Maximize chart" Click="DiagnosticExpand_Click" Tag="Residual">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding ResidualSummary}" Margin="6,2" FontSize="11"
                                           Foreground="#555" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ResidualSummary}"/>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding ResidualSeries}"
                                                    XAxes="{Binding ResidualXAxes}"
                                                    YAxes="{Binding ResidualYAxes}"
                                                    ZoomMode="Both" ZoomingSpeed="0.15"
                                                    LegendPosition="Top" LegendTextSize="9" TooltipPosition="Top"
                                                    Background="White"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="SymmetryPanel" Grid.Row="2" Grid.Column="2" Margin="2">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MIXI / AWG POS-NEG Symmetry Mismatch" VerticalAlignment="Center"/>
                                    <Button x:Name="SymmetryExpandButton" Width="22" Height="18" Padding="0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Maximize chart" Click="DiagnosticExpand_Click" Tag="Symmetry">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding SymmetrySummary}" Margin="6,2" FontSize="11"
                                           Foreground="#555" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SymmetrySummary}"/>
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding SymmetrySeries}"
                                                    XAxes="{Binding SymmetryXAxes}"
                                                    YAxes="{Binding SymmetryYAxes}"
                                                    ZoomMode="Both" ZoomingSpeed="0.15"
                                                    LegendPosition="Top" TooltipPosition="Top"
                                                    Background="White"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
